{% set raw = data|replace({' ': ''}) %}
{% set phone = raw %}

{% if phone starts with '+420' and phone|length == 13 %}
    {# Český formát s předvolbou #}
    {{ phone|slice(0, 4) ~ ' ' ~ phone|slice(4, 3) ~ ' ' ~ phone|slice(7, 3) ~ ' ' ~ phone|slice(10) }}

{% elseif phone matches('/^\d{9}$/') %}
    {# Český formát bez předvolby – doplníme +420 #}
    {{ '+420 ' ~ phone|slice(0, 3) ~ ' ' ~ phone|slice(3, 3) ~ ' ' ~ phone|slice(6) }}

{% else %}
    {# Jiný formát – fallback s mezerami po 3 číslicích #}
    {% set chunks = [] %}
    {% for i in 0..(phone|length / 3 - 1)|round(0, 'floor') %}
        {% set chunks = chunks|merge([phone|slice(i * 3, 3)]) %}
    {% endfor %}
    {{ chunks|join(' ') }}
{% endif %}
