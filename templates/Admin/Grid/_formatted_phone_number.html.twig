{% set phone = data|replace({' ': ''}) %}

{% if phone starts with '+420' and phone|length == 13 %}
    {{ phone|slice(0, 4) ~ ' ' ~ phone|slice(4, 3) ~ ' ' ~ phone|slice(7, 3) ~ ' ' ~ phone|slice(10) }}
{% elseif phone|length == 9 %}
    {{ phone|slice(0, 3) ~ ' ' ~ phone|slice(3, 3) ~ ' ' ~ phone|slice(6) }}
{% else %}
    {{ phone }}
{% endif %}
